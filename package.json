{
  "name": "gitlab-bpmn-viewer",
  "version": "2.0.21",
  "description": "Расширение для визуализации BPMN-диаграмм в GitLab",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:chrome": "cross-env TARGET=chrome vite build",
    "build:firefox": "cross-env TARGET=firefox vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitest/coverage-v8": "^2.1.6",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^6.0.1",
    "vite-plugin-web-extension": "^4.5.0",
    "vitest": "^2.1.6",
    "webextension-polyfill": "^0.12.0",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1"
  },
  "dependencies": {
    "bpmn-js": "^18.4.1"
  }
}
